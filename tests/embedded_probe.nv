// tests/embedded_probe.nv — the claim that `tzrule` runs on a
// microcontroller, as a program that builds for one or does not.
//
// It is not a test.  The shard audit's `core-embedded` row copies it and
// the modules it names into a package of its own and runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a Cortex-M4 executable or fails.  The executable prints
// `PASS: tz-embedded` under QEMU when the eleven checks in `score` hold.
//
// The claim covers `tzrule` and nothing else.  The device it is for is a
// battery clock, a thermostat or a meter with a real-time clock chip: no
// filesystem, no network, one zone known when it was made, and the forty
// bytes of rule that describe it,
//
//   CET-1CEST,M3.5.0,M10.5.0/3
//
// held as the integers below.  `tzdata` holds a pack of 127 KB, `tzzone`
// and `tzif` build lists, and `tzlocal` speaks calendar-nv's civil
// types, which do not build for a device.

use tzrule

// Berlin's rule as a device holds it: one hour east in winter and two
// in summer, changing on the last Sunday of March at 02:00 local and
// the last Sunday of October at 03:00 local.  Constants, because that is
// what a provisioning step writes into flash.
const STD_OFFSET: Int = 3600
const DST_OFFSET: Int = 7200
const START_MONTH: Int = 3
const START_WEEK: Int = 5
const START_DAY: Int = 0
const START_TIME: Int = 7200
const END_MONTH: Int = 10
const END_WEEK: Int = 5
const END_DAY: Int = 0
const END_TIME: Int = 10800

// How many of the eleven checks hold.  A firmware image has one line of
// output, and it depends on every check.
@tier(embedded)
fn score() -> Int
    var n = 0
    // The leap-year rule, which this module carries itself.
    if tzrule.is_leap_year(2024)
        n = n + 1
    if tzrule.is_leap_year(1900) == false
        n = n + 1
    // Two of the three date forms, as a device holds them.
    let m_form: TzPosixForm = TzPosixMonthWeekDay
    let j_form: TzPosixForm = TzPosixJulianNoLeap
    // The last Sunday in March 2026 is the 29th, day 87 of the year
    // counting from zero.
    if tzrule.rule_day_of_year(m_form, START_MONTH, START_WEEK, START_DAY, 2026) == 87
        n = n + 1
    // `J60` is the 1st of March in every year, leap or not, which is
    // day 60 of 2024 counting from zero.
    if tzrule.rule_day_of_year(j_form, 0, 0, 60, 2024) == 60
        n = n + 1
    // The two change instants of 2026 as seconds of the year.
    let start = tzrule.rule_second_of_year(m_form, START_MONTH, START_WEEK,
                                            START_DAY, START_TIME, 2026)
    let finish = tzrule.rule_second_of_year(m_form, END_MONTH, END_WEEK,
                                             END_DAY, END_TIME, 2026)
    if start < finish
        n = n + 1
    // Midsummer is inside the northern rule and midwinter is not.
    if tzrule.local_is_dst(start, finish, 15_000_000)
        n = n + 1
    if tzrule.local_is_dst(start, finish, 1_000_000) == false
        n = n + 1
    // The offset each answer picks.
    if tzrule.offset_for(STD_OFFSET, DST_OFFSET, true) == DST_OFFSET
        n = n + 1
    if tzrule.offset_for(STD_OFFSET, DST_OFFSET, false) == STD_OFFSET
        n = n + 1
    // An RTC reading, 2025-06-15T15:06:40Z, as the year and the second
    // of it that `local_is_dst` takes.
    let y = tzrule.local_year(1_750_000_000, STD_OFFSET)
    if y == 2025
        n = n + 1
    let soy = tzrule.local_second_of_year(1_750_000_000, STD_OFFSET, y)
    if soy > 0
        n = n + 1
    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    // Eleven checks, all of which hold on a host.
    let n = score()
    if n == 11
        hal.uart.write("PASS: tz-embedded\n")
    else
        hal.uart.write("FAIL: tz-embedded\n")
    loop
        core.rt.sleep_ms(1000)
