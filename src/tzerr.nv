// tzerr — what can be wrong while a zone is assembled or asked, and
// where.
//
// The pack reader, the TZif reader, the POSIX rule parser, the zone
// lookup and the local-time policy all answer this one enum.  A caller
// assembling a zone does several of them in sequence, and one error type
// keeps that a chain of `!` rather than nested matches.  `source_of`
// says which of them spoke.
//
// A refusal about bytes names the byte.  A zone file that fails to parse
// is a file somebody has to open in a hex editor, and a message naming
// only the file sends them to the start of a 3 KB binary.  `offset_of`
// answers -1 for a refusal that is not about a byte: an unknown name, a
// local time the caller's policy refused, a table that a transition
// index does not fit.
//
// A local time in a spring-forward gap or an autumn overlap is not an
// error.  Those are `tzlocal.TzLocal`'s other two variants.
// `tzlocal.to_utc` answers `TzLocalRefused` only because the caller
// passed `TzPickReject` and asked to be refused.

// What went wrong while a zone was being assembled or asked.
pub enum TzError
    // No zone and no link by that name in this database.  The name is
    // carried, so a caller reading one from a configuration file can
    // print what the file said.
    TzUnknownZone(name: Str)
    // The pack does not decode.  `offset` is the byte where the reader
    // stopped.
    TzPackUnreadable(offset: Int)
    // The pack's layout version is not the one this release reads.
    // Both are carried: a pack built by a newer release is a different
    // failure from a damaged one, and wants a different answer from the
    // operator.
    TzPackVersion(found: Str, expected: Str)
    // The zone has no table to report a horizon from.  `at` is the
    // instant the question was about, or 0 when it was about the table
    // as a whole.
    TzZoneOutOfRange(zone: Str, at: Int)
    // A POSIX TZ string did not parse, at this byte offset into it.
    TzPosixMalformed(offset: Int)
    // The first four bytes were not `TZif`.
    TzifBadMagic
    // The TZif version byte names a version this reader does not
    // implement.  Versions 1 to 4 are read, and the byte is carried so a
    // file from the future says so by number.
    TzifUnsupportedVersion(found: Int)
    // The file ended inside a field.  `at` is the offset the field
    // starts at, `needed` how many bytes it wanted, and `had` how many
    // were left.
    TzifTruncated(at: Int, needed: Int, had: Int)
    // The header declared zero local-time types.  RFC 8536 section 3.1
    // requires at least one, because the time before the first
    // transition has a type too.
    TzifNoTypes
    // A transition names a type past the end of the type table.  The
    // index and the table's size are both carried.
    TzifTypeIndexOutOfRange(index: Int, types: Int)
    // `tzlocal.to_utc` was passed `TzPickReject` and the wall time was
    // not unique in the zone.  `local_second` is the wall time as
    // seconds since 1970-01-01T00:00:00 on the wall clock, and
    // `happened` is how many instants it names: 0 in a gap, 2 in an
    // overlap.
    TzLocalRefused(zone: Str, local_second: Int, happened: Int)

// A refusal says what it is in one line, with the position in it.
//
// `Result<T, TzError>` requires the `Error` trait (SPEC § 3.4).  The
// wording is lower case, the fact first, with no trailing stop.
//
// ```novo
// use tzerr
//
// fn main() [io]
//     println(TzUnknownZone("Europe/Atlantis").message())   // unknown zone 'Europe/Atlantis'
// ```
impl Error for TzError
    // One sentence per variant, quoting what the variant carries.
    fn message(self) -> Str
        match self
            TzUnknownZone(name)            => "unknown zone '${name}'"
            TzPackUnreadable(at)           => "unreadable pack at offset ${at}"
            TzPackVersion(found, want)     => "pack layout ${found} where ${want} is read"
            TzZoneOutOfRange(zone, at)     => "zone '${zone}' has no table to answer ${at} from"
            TzPosixMalformed(at)           => "malformed POSIX TZ string at offset ${at}"
            TzifBadMagic                   => "not a TZif file: the first four bytes are not 'TZif'"
            TzifUnsupportedVersion(v)      => "TZif version byte ${v} is not read"
            TzifTruncated(at, needed, had) => "TZif file ends at offset ${at}: ${needed} bytes needed, ${had} left"
            TzifNoTypes                    => "TZif header declares no local-time types"
            TzifTypeIndexOutOfRange(i, n)  => "TZif transition names type ${i} of ${n}"
            TzLocalRefused(zone, at, n)    => refused_message(zone, at, n)

// The message for a wall time the policy refused.
fn refused_message(zone: Str, at: Int, happened: Int) -> Str
    if happened == 0
        "wall time ${at} never happened in zone '${zone}'"
    else
        "wall time ${at} happened ${happened} times in zone '${zone}'"

// The byte offset the failure is at, or -1 where the failure is not
// about a byte.
//
// calendar-nv's `calerror.offset_of` answers the same question the
// same way.
//
// ```novo
// use tzerr
//
// fn main() [io]
//     println("${tzerr.offset_of(TzPosixMalformed(3))}")   // 3
// ```
pub fn offset_of(e: TzError) -> Int []
    match e
        TzUnknownZone(_)              => -1
        TzPackUnreadable(at)          => at
        TzPackVersion(_, _)           => 5
        TzZoneOutOfRange(_, _)        => -1
        TzPosixMalformed(at)          => at
        TzifBadMagic                  => 0
        TzifUnsupportedVersion(_)     => 4
        TzifTruncated(at, _, _)       => at
        TzifNoTypes                   => -1
        TzifTypeIndexOutOfRange(_, _) => -1
        TzLocalRefused(_, _, _)       => -1

// Which reader produced the failure: `"pack"`, `"tzif"`, `"posix"`,
// `"lookup"` or `"local"`.
//
// A string rather than a second enum, because a caller only puts it in
// a message.
pub fn source_of(e: TzError) -> Str []
    match e
        TzUnknownZone(_)              => "lookup"
        TzPackUnreadable(_)           => "pack"
        TzPackVersion(_, _)           => "pack"
        TzZoneOutOfRange(_, _)        => "lookup"
        TzPosixMalformed(_)           => "posix"
        TzifBadMagic                  => "tzif"
        TzifUnsupportedVersion(_)     => "tzif"
        TzifTruncated(_, _, _)        => "tzif"
        TzifNoTypes                   => "tzif"
        TzifTypeIndexOutOfRange(_, _) => "tzif"
        TzLocalRefused(_, _, _)       => "local"
