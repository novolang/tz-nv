// tzposix — the POSIX TZ string: reading it, writing it, and asking a
// rule about an instant.
//
// A POSIX TZ string such as `CET-1CEST,M3.5.0,M10.5.0/3` names a
// standard time, a daylight time, and the two dates between which
// daylight time is in force (POSIX.1 section 8.3).  Every version-2 TZif
// file ends with one, its footer.  The transition table in the file
// stops, and the footer says what the rule is after it.  A zone reader
// that ignored the footer would answer the last table entry forever.
//
// The arithmetic under this module is `tzrule`'s, which also runs on a
// microcontroller.  This module holds a `Str`, so it runs on a host.
//
// Every offset here is seconds east of UTC, which is the opposite of the
// sign the TZ string writes.  `CET-1` means one hour east, because POSIX
// reads the number as what to add to local time to reach UTC.  `parse`
// flips the sign once, and `format` flips it back.
//
// RFC 8536 section 3.3.1 extends POSIX in two ways that real footers
// use, and both are read: an hour of a change time may run from -167 to
// 167, and an abbreviation in angle brackets may hold digits and signs.

use std.str
use std.list
use tzerr
use tzrule

// One end of a daylight-saving rule: a date and the local time of day
// the change takes effect.
pub struct TzPosixDate
    // Which of the three spellings the numbers below are in.
    form: TzPosixForm
    // `1 ..= 12` for `TzPosixMonthWeekDay`, and 0 for the Julian forms.
    month: Int
    // `1 ..= 5` for `TzPosixMonthWeekDay`, with 5 meaning the last, and
    // 0 for the Julian forms.
    week: Int
    // `0 ..= 6` for `TzPosixMonthWeekDay`, Sunday first as POSIX numbers
    // it.  `1 ..= 365` for `TzPosixJulianNoLeap` and `0 ..= 365` for
    // `TzPosixJulianLeap`.
    day: Int
    // Seconds after local midnight at which the change happens.  The
    // default is 7200, two in the morning, and the `/3` in `M10.5.0/3`
    // is 10800.  It may be negative and it may exceed a day: `/-1` and
    // `/24` both occur in real footers.
    time_seconds: Int

// A whole POSIX TZ rule: a standard offset, and optionally a daylight
// one with the two dates it runs between.
pub struct TzPosixRule
    // `"CET"`, `"EST"`, or `"+0530"` for the quoted `<+0530>`.
    std_abbrev: Str
    // Seconds east of UTC when daylight saving is not in force.
    std_offset_seconds: Int
    // False when the string names no daylight time, in which case the
    // four fields below are not read.
    has_dst: Bool
    // `"CEST"`, `"EDT"`.
    dst_abbrev: Str
    // Seconds east of UTC while daylight saving is in force.  When the
    // string gives none it is one hour more than the standard offset,
    // as POSIX says.
    dst_offset_seconds: Int
    // When daylight saving begins, in local standard time.
    start: TzPosixDate
    // When it ends, in local daylight time.  The two ends are read on
    // different clocks, which is why the arithmetic below takes the
    // saving into account at the end date.
    end: TzPosixDate

// ── Parsing ─────────────────────────────────────────────────────────

// The byte at `i`, or -1 past the end.
fn at(s: Str, i: Int) -> Int
    str.byte_at_or(s, i, -1)

// Whether a byte is an ASCII letter.
fn is_alpha(b: Int) -> Bool
    b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z'

// Whether a byte is an ASCII digit.
fn is_digit(b: Int) -> Bool
    b >= '0' and b <= '9'

// An abbreviation at `i`, unquoted or in angle brackets, with the
// offset past it.
fn read_name(s: Str, i: Int) -> Result<(Str, Int), tzerr.TzError>
    if at(s, i) == '<'
        var j = i + 1
        while is_alpha(at(s, j)) or is_digit(at(s, j)) or at(s, j) == '+' or at(s, j) == '-'
            j = j + 1
        if at(s, j) != '>' or j - i - 1 < 3
            return Err(TzPosixMalformed(j))
        return Ok((str.slice(s, i + 1, j), j + 1))
    var j = i
    while is_alpha(at(s, j))
        j = j + 1
    if j - i < 3
        return Err(TzPosixMalformed(j))
    Ok((str.slice(s, i, j), j))

// One to `width` digits at `i` as a number, with the offset past them.
fn read_number(s: Str, i: Int, width: Int) -> Result<(Int, Int), tzerr.TzError>
    var n = 0
    var j = i
    while j - i < width and is_digit(at(s, j))
        n = n * 10 + at(s, j) - '0'
        j = j + 1
    if j == i
        return Err(TzPosixMalformed(i))
    Ok((n, j))

// `[+-]hh[:mm[:ss]]` at `i` as signed seconds, the hour at most
// `max_hours`, with the offset past it.
fn read_hms(s: Str, i: Int, max_hours: Int) -> Result<(Int, Int), tzerr.TzError>
    var sign = 1
    var j = i
    if at(s, j) == '+' or at(s, j) == '-'
        if at(s, j) == '-'
            sign = -1
        j = j + 1
    let (h, after_h) = read_number(s, j, 3)!
    if h > max_hours
        return Err(TzPosixMalformed(j))
    var total = h * 3600
    j = after_h
    if at(s, j) == ':'
        let (m, after_m) = read_number(s, j + 1, 2)!
        if m > 59
            return Err(TzPosixMalformed(j + 1))
        total = total + m * 60
        j = after_m
        if at(s, j) == ':'
            let (sec, after_s) = read_number(s, j + 1, 2)!
            if sec > 59
                return Err(TzPosixMalformed(j + 1))
            total = total + sec
            j = after_s
    Ok((sign * total, j))

// `n` read at `i` and checked against `low ..= high`, with the offset
// past it.
fn read_bounded(s: Str, i: Int, low: Int, high: Int) -> Result<(Int, Int), tzerr.TzError>
    let (n, j) = read_number(s, i, 3)!
    if n < low or n > high
        return Err(TzPosixMalformed(i))
    Ok((n, j))

// A rule date at `i` and its optional `/time`, with the offset past it.
fn read_date(s: Str, i: Int) -> Result<(TzPosixDate, Int), tzerr.TzError>
    var form = TzPosixJulianLeap
    var month = 0
    var week = 0
    var day = 0
    var j = i
    if at(s, i) == 'M'
        let (m, after_m) = read_bounded(s, i + 1, 1, 12)!
        if at(s, after_m) != '.'
            return Err(TzPosixMalformed(after_m))
        let (w, after_w) = read_bounded(s, after_m + 1, 1, 5)!
        if at(s, after_w) != '.'
            return Err(TzPosixMalformed(after_w))
        let (d, after_d) = read_bounded(s, after_w + 1, 0, 6)!
        form = TzPosixMonthWeekDay
        month = m
        week = w
        day = d
        j = after_d
    else if at(s, i) == 'J'
        let (n, after_n) = read_bounded(s, i + 1, 1, 365)!
        form = TzPosixJulianNoLeap
        day = n
        j = after_n
    else
        let (n, after_n) = read_bounded(s, i, 0, 365)!
        day = n
        j = after_n
    var change = 7200
    if at(s, j) == '/'
        let (t, after_t) = read_hms(s, j + 1, 167)!
        change = t
        j = after_t
    Ok((TzPosixDate { form: form, month: month, week: week, day: day, time_seconds: change }, j))

// The date POSIX uses when a rule has none: never read, because a rule
// without dates is refused.
fn no_date() -> TzPosixDate
    TzPosixDate { form: TzPosixJulianLeap, month: 0, week: 0, day: 0, time_seconds: 7200 }

// Parse a POSIX TZ string.
//
// Reads the quoted form (`<+0530>-5:30`), an offset with minutes and
// seconds (`-4:30:00`), a daylight time with no offset of its own, and
// the `M`, `J` and bare-number date forms.  A daylight time with no
// dates is refused: POSIX leaves it to the implementation, and the
// implementations disagree.  Every refusal is `TzPosixMalformed` at the
// byte where the reading stopped.
//
// ```novo
// use tzposix
//
// fn main() [io]
//     match tzposix.parse("CET-1CEST,M3.5.0,M10.5.0/3")
//         Ok(r)  => println("${r.std_abbrev} ${r.std_offset_seconds}")   // CET 3600
//         Err(_) => println("not a TZ string")
// ```
pub fn parse(s: Str) -> Result<TzPosixRule, tzerr.TzError> []
    let (std_name, after_name) = read_name(s, 0)!
    let (west, after_off) = read_hms(s, after_name, 24)!
    let n = str.len(s)
    if after_off == n
        return Ok(fixed(std_name, -west))
    let (dst_name, after_dst) = read_name(s, after_off)!
    var dst_off = -west + 3600
    var j = after_dst
    if at(s, j) != ','
        let (dst_west, after_dst_off) = read_hms(s, j, 24)!
        dst_off = -dst_west
        j = after_dst_off
    if at(s, j) != ','
        return Err(TzPosixMalformed(j))
    let (start, after_start) = read_date(s, j + 1)!
    if at(s, after_start) != ','
        return Err(TzPosixMalformed(after_start))
    let (end, after_end) = read_date(s, after_start + 1)!
    if after_end != n
        return Err(TzPosixMalformed(after_end))
    Ok(TzPosixRule {
        std_abbrev: std_name,
        std_offset_seconds: -west,
        has_dst: true,
        dst_abbrev: dst_name,
        dst_offset_seconds: dst_off,
        start: start,
        end: end })

// ── Writing ─────────────────────────────────────────────────────────

// An abbreviation as the string writes it: bare when it is three or
// more letters, in angle brackets otherwise.
fn name_text(name: Str) -> Str
    var letters = str.len(name) >= 3
    for k in 0..str.len(name)
        if not is_alpha(at(name, k))
            letters = false
    if letters
        name
    else
        "<${name}>"

// Signed seconds as `[-]h[:mm[:ss]]`, with the minutes and seconds only
// when they are not zero.
fn hms_text(v: Int) -> Str
    let sign = if v < 0
        "-"
    else
        ""
    let a = if v < 0
        -v
    else
        v
    let h = a / 3600
    let m = a / 60 % 60
    let sec = a % 60
    if sec != 0
        "${sign}${h}:${pad2(m)}:${pad2(sec)}"
    else if m != 0
        "${sign}${h}:${pad2(m)}"
    else
        "${sign}${h}"

// A number below 100 in two digits.
fn pad2(n: Int) -> Str
    if n < 10
        "0${n}"
    else
        "${n}"

// A rule date as the string writes it, with `/time` only when the time
// is not the default two in the morning.
fn date_text(d: TzPosixDate) -> Str
    let head = match d.form
        TzPosixMonthWeekDay => "M${d.month}.${d.week}.${d.day}"
        TzPosixJulianNoLeap => "J${d.day}"
        TzPosixJulianLeap   => "${d.day}"
    if d.time_seconds == 7200
        head
    else
        "${head}/${hms_text(d.time_seconds)}"

// Write the rule back out as a POSIX TZ string.
//
// `parse` then `format` is not always the identity: `M10.5.0/2` comes
// back without its default `/2`, and `<CET>` without its brackets.
// `format` then `parse` is the identity, which is the direction a footer
// written by this package needs.
//
// ```novo
// use tzposix
//
// fn main() [io]
//     println(tzposix.format(tzposix.fixed("+0530", 19800)))   // <+0530>-5:30
// ```
pub fn format(r: TzPosixRule) -> Str []
    let std_part = "${name_text(r.std_abbrev)}${hms_text(-r.std_offset_seconds)}"
    if not r.has_dst
        return std_part
    var dst_part = name_text(r.dst_abbrev)
    if r.dst_offset_seconds != r.std_offset_seconds + 3600
        dst_part = "${dst_part}${hms_text(-r.dst_offset_seconds)}"
    "${std_part}${dst_part},${date_text(r.start)},${date_text(r.end)}"

// A rule with no daylight-saving part: one offset and one abbreviation,
// forever.
//
// What `TZ=UTC0` is, and what every fixed-offset zone reduces to.
pub fn fixed(abbrev: Str, offset_seconds: Int) -> TzPosixRule []
    TzPosixRule {
        std_abbrev: abbrev,
        std_offset_seconds: offset_seconds,
        has_dst: false,
        dst_abbrev: "",
        dst_offset_seconds: offset_seconds,
        start: no_date(),
        end: no_date() }

// Whether the rule never changes offset.
pub fn is_fixed(r: TzPosixRule) -> Bool []
    not r.has_dst

// ── Asking a rule about an instant ──────────────────────────────────

// The second of year `y` at which a rule date takes effect, on the
// clock the date is written in.
fn date_second(d: TzPosixDate, y: Int) -> Int
    tzrule.rule_second_of_year(d.form, d.month, d.week, d.day, d.time_seconds, y)

// Whether daylight saving is in force at a UTC second under a rule
// with daylight saving.
fn dst_in_force(r: TzPosixRule, utc_second: Int) -> Bool
    let std = r.std_offset_seconds
    let y = tzrule.local_year(utc_second, std)
    let a = date_second(r.start, y)
    let b = date_second(r.end, y) - (r.dst_offset_seconds - std)
    tzrule.local_is_dst(a, b, tzrule.local_second_of_year(utc_second, std, y))

// The offset, in seconds east of UTC, at a UTC instant.
//
// ```novo
// use tzposix
//
// fn main() [io]
//     let r = tzposix.parse("CET-1CEST,M3.5.0,M10.5.0/3")!
//     println("${tzposix.offset_seconds_at(r, 1784116800)}")   // 7200
// ```
pub fn offset_seconds_at(r: TzPosixRule, utc_second: Int) -> Int []
    tzrule.offset_for(r.std_offset_seconds, r.dst_offset_seconds, is_dst_at(r, utc_second))

// Whether daylight saving is in force at a UTC instant.
pub fn is_dst_at(r: TzPosixRule, utc_second: Int) -> Bool []
    r.has_dst and dst_in_force(r, utc_second)

// The abbreviation in force at a UTC instant.
pub fn abbrev_at(r: TzPosixRule, utc_second: Int) -> Str []
    if is_dst_at(r, utc_second)
        r.dst_abbrev
    else
        r.std_abbrev

// The UTC seconds at which the rule changes in the years around
// `utc_second`, ascending, keeping only the ones where the offset or the
// daylight flag differs on the two sides.
//
// A rule that keeps daylight time all year, such as `EST5EDT,0/0,J365/25`,
// names a change at every new year that changes nothing, and it is
// dropped here.
fn changes_near(r: TzPosixRule, utc_second: Int) -> [Int]
    let std = r.std_offset_seconds
    let dst = r.dst_offset_seconds
    let y = tzrule.local_year(utc_second, std)
    var found: [Int] = []
    for year in y - 1..y + 3
        let base = tzrule.year_start_second(year)
        let on = base + date_second(r.start, year) - std
        let off = base + date_second(r.end, year) - dst
        list.push(found, on)
        list.push(found, off)
    list.sort(found)
    var kept: [Int] = []
    for c in found
        if is_dst_at(r, c - 1) != is_dst_at(r, c)
            list.push(kept, c)
    kept

// The UTC second of the rule's next change strictly after
// `utc_second`.
//
// A fixed rule has none.  A rule with dates always has one, which is how
// a zone with a footer answers questions about the year 2400.
pub fn next_change_after(r: TzPosixRule, utc_second: Int) -> ?Int []
    if not r.has_dst
        return None
    for c in changes_near(r, utc_second)
        if c > utc_second
            return Some(c)
    None

// The UTC second of the rule's last change at or before `utc_second`.
pub fn last_change_before(r: TzPosixRule, utc_second: Int) -> ?Int []
    if not r.has_dst
        return None
    var last: ?Int = None
    for c in changes_near(r, utc_second)
        if c <= utc_second
            last = Some(c)
    last
