// tzzone — one zone, and the questions asked of it at a UTC instant.
//
// A zone is a step function from instants to offsets.  Give it a UTC
// second and it answers how far east of UTC the wall clocks were, what
// the offset was called, and whether daylight saving was in force.
// Exactly one offset is in force at any UTC second, so no call here
// fails and none answers a `Result`.  The inverse, a wall time to the
// instants it names, is not a function, and it is `tzlocal`'s.
//
// A zone answers from its transition table where the table reaches,
// and from its POSIX footer rule past the end of it.  A caller who needs
// to tell a record from an extrapolation asks `table_covers`.
//
// Every offset is in seconds east of UTC: Berlin in winter is 3600,
// Kolkata 19800, New York in winter -18000.
//
// A TZif file records an offset and a daylight flag for each local-time
// type, and not the saving.  `build` recovers the saving the way
// Python's `zoneinfo` does: a daylight type's saving is its offset less
// the offset of the standard type next to it in the table.

use std.list
use tzerr
use tzposix
use tzrule

// The offset in force at some instant, with the facts printed beside
// it.
pub struct TzOffset
    // The total offset east of UTC, in seconds: standard plus saving.
    // A UTC second plus this number is the wall-clock second.
    total_seconds: Int
    // The standard part on its own.
    standard_seconds: Int
    // The daylight-saving part: 0 outside it, usually 3600 inside, 1800
    // on Lord Howe Island and 7200 at Troll in Antarctica.
    save_seconds: Int
    // What the offset is called: `"CET"`, `"CEST"`, `"IST"`, or a
    // numeric form such as `"+0530"` where the zone has no name for it.
    abbrev: Str
    // Whether daylight saving is in force.  A TZif file carries this
    // flag on its own, and it is kept as the file wrote it.
    is_dst: Bool

// One change of offset: when it happened, and the offset on each side.
pub struct TzTransition
    // The UTC second at which the new offset takes effect: the first
    // instant at the new offset.
    at: Int
    // What was in force immediately before.
    before: TzOffset
    // What is in force from `at` onward.
    after: TzOffset

// A time zone: a name, a transition table, and optionally a POSIX
// footer rule for instants past the table's end.
//
// The table is held in the last three fields.  They are read through
// the functions below, which is the surface this package keeps stable.
pub struct TzZone
    // The canonical IANA name, `"Europe/Berlin"`.  A zone reached through
    // a link carries the canonical name, not the link.
    name: Str
    // How many transitions the table holds.
    transition_count: Int
    // The rule for instants past the table's end, or `None` where the
    // zone has none.
    rule: ?tzposix.TzPosixRule
    // The transition instants, UTC seconds, ascending.
    times: [Int]
    // For each transition, the index into `types` of what takes effect.
    kinds: [Int]
    // The offsets the table uses.  The first is in force before the
    // first transition, as RFC 8536 section 3.2 says.
    types: [TzOffset]

// A zone from a TZif-shaped table: the transitions, the type each one
// starts, and for each type its total offset, daylight flag and
// abbreviation.  The saving and the standard part are worked out here.
fn build(name: Str, times: [Int], kinds: [Int], utoffs: [Int], dsts: [Bool], abbrevs: [Str],
         rule: ?tzposix.TzPosixRule) -> TzZone
    var types: [TzOffset] = []
    for k in 0..list.len(utoffs)
        let save = if dsts[k]
            save_of(k, kinds, utoffs, dsts, rule)
        else
            0
        list.push(types, TzOffset {
            total_seconds: utoffs[k],
            standard_seconds: utoffs[k] - save,
            save_seconds: save,
            abbrev: abbrevs[k],
            is_dst: dsts[k] })
    TzZone {
        name: name,
        transition_count: list.len(times),
        rule: rule,
        times: times,
        kinds: kinds,
        types: types }

// The saving of daylight type `k`: its offset less the offset of the
// standard type just before or just after its first use in the table,
// or the footer rule's saving, or an hour.
fn save_of(k: Int, kinds: [Int], utoffs: [Int], dsts: [Bool], rule: ?tzposix.TzPosixRule) -> Int
    for i in 0..list.len(kinds)
        if kinds[i] == k
            let prev = if i == 0
                0
            else
                kinds[i - 1]
            if not dsts[prev]
                return utoffs[k] - utoffs[prev]
            if i + 1 < list.len(kinds) and not dsts[kinds[i + 1]]
                return utoffs[k] - utoffs[kinds[i + 1]]
    match rule
        Some(r) => r.dst_offset_seconds - r.std_offset_seconds
        None    => 3600

// The offset a rule gives at a UTC second.
fn rule_offset(r: tzposix.TzPosixRule, utc_second: Int) -> TzOffset
    let dst = tzposix.is_dst_at(r, utc_second)
    let save = if dst
        r.dst_offset_seconds - r.std_offset_seconds
    else
        0
    TzOffset {
        total_seconds: tzrule.offset_for(r.std_offset_seconds, r.dst_offset_seconds, dst),
        standard_seconds: r.std_offset_seconds,
        save_seconds: save,
        abbrev: tzposix.abbrev_at(r, utc_second),
        is_dst: dst }

// The index of the last transition at or before `utc_second`, or -1
// when the instant precedes them all.  A binary search.
fn index_at(z: TzZone, utc_second: Int) -> Int
    var lo = 0
    var hi = list.len(z.times)
    while lo != hi
        let mid = (lo + hi) / 2
        if z.times[mid] <= utc_second
            lo = mid + 1
        else
            hi = mid
    lo - 1

// The instant of the table's last transition, or the smallest `Int`
// for an empty table.
fn last_time(z: TzZone) -> Int
    if list.len(z.times) == 0
        -9223372036854775807 - 1
    else
        z.times[-1]

// The type in force after table index `i`, where -1 is before the
// first transition.
fn type_after(z: TzZone, i: Int) -> TzOffset
    if i < 0
        z.types[0]
    else
        z.types[z.kinds[i]]

// The zone's canonical IANA name.
pub fn zone_name(z: TzZone) -> Str []
    z.name

// The offset in force at a UTC instant.
//
// Past the table's last transition the footer rule answers, and with no
// footer rule the last transition's offset does.  `table_covers` says
// which answered.
//
// ```novo
// use tzdata
// use tzzone
//
// fn main() [io]
//     let z = tzdata.zone(tzdata.data_compact(), "Europe/Berlin")!
//     println(tzzone.offset_at(z, 1750000000).abbrev)   // CEST
// ```
pub fn offset_at(z: TzZone, utc_second: Int) -> TzOffset []
    if utc_second > last_time(z)
        match z.rule
            Some(r) =>
                return rule_offset(r, utc_second)
            None    =>
                return type_after(z, list.len(z.times) - 1)
    type_after(z, index_at(z, utc_second))

// The offset in seconds east of UTC at a UTC instant.
pub fn offset_seconds_at(z: TzZone, utc_second: Int) -> Int []
    offset_at(z, utc_second).total_seconds

// The abbreviation in force at a UTC instant.
pub fn abbrev_at(z: TzZone, utc_second: Int) -> Str []
    offset_at(z, utc_second).abbrev

// Whether daylight saving is in force at a UTC instant.
pub fn is_dst_at(z: TzZone, utc_second: Int) -> Bool []
    offset_at(z, utc_second).is_dst

// A change the footer rule makes at `at`.
fn rule_transition(r: tzposix.TzPosixRule, at: Int) -> TzTransition
    TzTransition { at: at, before: rule_offset(r, at - 1), after: rule_offset(r, at) }

// The first transition strictly after a UTC instant, or `None` where
// the zone makes no further change.
//
// What a scheduler asks: when the offset just computed stops being
// right.  Past the table's end the footer rule supplies it.
pub fn transition_after(z: TzZone, utc_second: Int) -> ?TzTransition []
    let i = index_at(z, utc_second) + 1
    if i < list.len(z.times)
        return transition_at(z, i)
    match z.rule
        Some(r) => footer_after(r, utc_second)
        None    => None

// The footer rule's first change after `utc_second`, as a transition.
fn footer_after(r: tzposix.TzPosixRule, utc_second: Int) -> ?TzTransition
    match tzposix.next_change_after(r, utc_second)
        Some(c) => Some(rule_transition(r, c))
        None    => None

// The last transition at or before a UTC instant, or `None` where the
// instant precedes every transition the zone records.
pub fn transition_before(z: TzZone, utc_second: Int) -> ?TzTransition []
    if utc_second > last_time(z)
        if let Some(r) = z.rule
            if let Some(c) = tzposix.last_change_before(r, utc_second)
                if c > last_time(z)
                    return Some(rule_transition(r, c))
    transition_at(z, index_at(z, utc_second))

// Every transition in the half-open UTC range `[from_second,
// to_second)`, ascending.
//
// The footer rule contributes its changes past the table's end, so a
// European zone asked about the year 2400 answers two transitions that
// are in no file.
pub fn transitions_between(z: TzZone, from_second: Int, to_second: Int) -> [TzTransition] []
    var out: [TzTransition] = []
    let first = index_at(z, from_second - 1) + 1
    for k in first..list.len(z.times)
        if z.times[k] >= to_second
            break
        list.push(out, table_transition(z, k))
    if let Some(r) = z.rule
        var cursor = larger(from_second - 1, last_time(z))
        var more = true
        while more
            let c = tzposix.next_change_after(r, cursor) ?? to_second
            more = c < to_second
            if more
                list.push(out, rule_transition(r, c))
                cursor = c
    out

// The larger of two integers.
fn larger(a: Int, b: Int) -> Int
    if a > b
        a
    else
        b

// The `i`th transition in the zone's own table, counting from zero, or
// `None` where `i` is out of range.
//
// The table only: the footer rule's changes have no index.
pub fn transition_at(z: TzZone, i: Int) -> ?TzTransition []
    if i < 0 or i >= list.len(z.times)
        return None
    Some(table_transition(z, i))

// The table's transition `i`, for an `i` in range.
fn table_transition(z: TzZone, i: Int) -> TzTransition
    TzTransition { at: z.times[i], before: type_after(z, i - 1), after: type_after(z, i) }

// How many transitions the zone's table holds.
pub fn transition_count(z: TzZone) -> Int []
    list.len(z.times)

// Whether the zone's own table covers this instant: it lies between the
// first and the last transition, inclusive.
//
// Outside that range the answer is extrapolated, from the footer rule or
// from the first or last entry.  An application stamping a legal record
// may want to know which it got.
pub fn table_covers(z: TzZone, utc_second: Int) -> Bool []
    list.len(z.times) > 0 and z.times[0] <= utc_second and utc_second <= z.times[-1]

// The first and last UTC seconds of the zone's table, as a pair.
//
// A zone with no transitions answers `(0, 0)`, and `transition_count`
// of zero tells it apart from a table that covers the epoch alone.
pub fn table_range(z: TzZone) -> (Int, Int) []
    if list.len(z.times) == 0
        (0, 0)
    else
        (z.times[0], z.times[-1])

// The zone's POSIX footer rule, or `None` where it has none.
pub fn posix_rule(z: TzZone) -> ?tzposix.TzPosixRule []
    z.rule

// Whether two offsets are the same in every field.
fn same_offset(a: TzOffset, b: TzOffset) -> Bool
    a.total_seconds == b.total_seconds and a.save_seconds == b.save_seconds and a.abbrev == b.abbrev and a.is_dst == b.is_dst

// Add `o` to `seen` when no offset in it is the same.
fn add_distinct(var seen: [TzOffset], o: TzOffset)
    for s in seen
        if same_offset(s, o)
            return
    list.push(seen, o)

// Every distinct offset the zone has been at, in the order the table
// first uses them, then the footer rule's.
//
// What a picker fills a menu from, and what a validator checks a stored
// offset against.
pub fn offsets_of(z: TzZone) -> [TzOffset] []
    var seen: [TzOffset] = [z.types[0]]
    for k in z.kinds
        add_distinct(seen, z.types[k])
    if let Some(r) = z.rule
        add_distinct(seen, rule_offset(r, 0))
        if r.has_dst
            let change = tzposix.next_change_after(r, 0) ?? 0
            add_distinct(seen, rule_offset(r, change))
            add_distinct(seen, rule_offset(r, change - 1))
    seen

// A zone with one offset and no transitions.
//
// The spelling for an offset and a label with no rule at all, which is
// what a stored `+05:30` in a database row is.
//
// ```novo
// use tzzone
//
// fn main() [io]
//     let z = tzzone.fixed("Asia/Kolkata", 19800, "IST")
//     println("${tzzone.offset_seconds_at(z, 0)}")   // 19800
// ```
pub fn fixed(name: Str, offset_seconds: Int, abbrev: Str) -> TzZone []
    build(name, [], [], [offset_seconds], [false], [abbrev], None)

// UTC itself, as a zone.
pub fn utc() -> TzZone []
    fixed("UTC", 0, "UTC")

// A zone whose whole content is a POSIX rule and no table.
//
// What `TZ=EST5EDT,M3.2.0,M11.1.0` means, and what a device provisions
// itself with.  It answers every function in this module, and it knows
// nothing of any year in which the rule was different.
pub fn from_posix(rule: tzposix.TzPosixRule, name: Str) -> TzZone []
    build(name, [], [], [rule.std_offset_seconds], [false], [rule.std_abbrev], Some(rule))

// Whether the zone never changes offset: no transitions in its table,
// and no footer rule or a fixed one.
pub fn is_fixed(z: TzZone) -> Bool []
    if list.len(z.times) > 0
        return false
    match z.rule
        Some(r) => tzposix.is_fixed(r)
        None    => true

// The last instant the zone's table records.
//
// `Err` names the zone when it has no table at all.  Most callers want
// `table_covers`; this is for one that reports the horizon rather than
// testing a point.
pub fn table_horizon(z: TzZone) -> Result<Int, tzerr.TzError> []
    if list.len(z.times) == 0
        return Err(TzZoneOutOfRange(z.name, 0))
    Ok(z.times[-1])
